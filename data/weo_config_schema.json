{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "WEO Configuration Schema",
    "type": "object",
    "properties": {
        "apiBaseUrl":      {"type": "string",  "description": "AI 服务商 API 地址",       "default": ""},
        "apiKey":          {"type": "string",  "description": "用户 API Key",             "default": ""},
        "modelName":       {"type": "string",  "description": "模型名称",                  "default": ""},
        "systemPrompt":    {"type": "string",  "description": "系统提示词",                "default": ""},
        "userPrompt":      {"type": "string",  "description": "用户消息（随图片发送）",    "default": "请分析图片内容"},
        "temperature":     {"type": "number",  "description": "模型温度 (0.0–2.0)",       "default": 0.3,   "minimum": 0, "maximum": 2},
        "maxTokens":       {"type": "integer", "description": "最大输出 token 数",         "default": 1500,   "minimum": 1, "maximum": 8000},
        "timeoutMs":       {"type": "integer", "description": "请求超时（毫秒）",          "default": 30000,  "minimum": 5000, "maximum": 120000},
        "textCorrectionEnabled": {"type": "boolean", "description": "是否启用透视校正",   "default": true},
        "maxAnswerChars":  {"type": "integer", "description": "AI 回答最大字符数",         "default": 2000,   "minimum": 100, "maximum": 10000}
    },
    "required": ["apiBaseUrl", "apiKey", "modelName"]
}
